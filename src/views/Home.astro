---
import Layout from '../layouts/Layout.astro';
import Shell from '../components/Shell.astro';
import { fetchPublicGallery, galleryFor } from '../data/gallery';
import { gestionaleUrl } from '../data/menu';
import { aperitivi, site } from '../data/site';
import { localeFromPath, localizedPath, mapsEmbed, t } from '../i18n';
import { barJsonLd, faqJsonLd, webpageJsonLd, websiteJsonLd } from '../lib/jsonld';

const lang = localeFromPath(Astro.url.pathname);
const copy = t(lang);
const remoteGallery = await fetchPublicGallery();
const photos = remoteGallery ?? galleryFor(lang);
const galleryApi = gestionaleUrl();
const cards = aperitivi.map((item, index) => ({
  ...item,
  ...copy.aperitivi[index],
}));

const description = copy.description;
const path = localizedPath('/', lang);
const jsonLd = [
  barJsonLd(lang),
  websiteJsonLd(lang),
  webpageJsonLd({ path, title: `${site.name} · ${site.tagline}`, description, locale: lang }),
  faqJsonLd(lang),
];
---

<Layout
  title={site.name}
  description={description}
  path={path}
  jsonLd={jsonLd}
  breadcrumbs={[{ name: 'Home', path }]}
>
  <Shell>
    <section class="hero">
      <div class="wrap hero-grid">
        <div>
          <p class="kicker">{copy.home.kicker}</p>
          <h1>
            <span class="line-one">Less stress,</span>
            <span class="line-two">more spritz!</span>
          </h1>
          <p class="lead">{copy.home.lead}</p>
          <div class="hero-actions">
            <a class="btn" href="#aperitivi">{copy.home.ctaAperitivi}</a>
            <a class="btn btn-ghost" href={localizedPath('/menu', lang)}>{copy.home.ctaMenu}</a>
          </div>
        </div>
        <div class="hero-aside">
          <figure class="hero-photo">
            <img
              src="/aperol-spritz.jpg"
              width="938"
              height="1400"
              alt={copy.home.heroAlt}
              loading="eager"
              fetchpriority="high"
            />
            <figcaption>{copy.home.heroCaption}</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <div class="marquee" aria-hidden="true">
      <div class="track">
        {Array.from({ length: 8 }).map(() => (
          <span>{copy.home.marquee}</span>
        ))}
      </div>
    </div>

    <section class="section aperitivo-band" id="aperitivi">
      <div class="wrap">
        <p class="kicker">{copy.home.aperitivoKicker}</p>
        <h2>{copy.home.aperitivoTitle}</h2>
        <div class="tickets">
          {cards.map((item) => (
            <article class:list={['ticket', item.highlight && 'featured']}>
              <p class="when">{item.when}</p>
              <h3>{item.title}</h3>
              <p class="time">{item.time}</p>
              <p class="price">
                <span>{item.price}€</span>
                <small>{item.note}</small>
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section wrap locale">
      <figure class="locale-photo">
        <img
          src="/bar-interior.jpg"
          width="933"
          height="700"
          alt={copy.home.localeAlt}
          loading="lazy"
        />
      </figure>
      <div class="locale-copy">
        <p class="score">{site.rating.value}</p>
        <p class="kicker">{copy.home.google}</p>
        <h2>{copy.home.localeTitle}</h2>
        <p class="muted">{copy.home.localeText(site.rating.count, site.rating.value)}</p>
      </div>
    </section>

    <section class="section gallery" id="gallery">
      <div class="wrap">
        <p class="kicker">{copy.home.galleryKicker}</p>
        <h2>{copy.home.galleryTitle}</h2>
        <div class="mosaic" data-api={galleryApi} data-open-photo={copy.home.openPhoto}>
          {photos.map((photo, index) => (
            <button
              class:list={['shot', photo.layout]}
              type="button"
              data-gallery-shot
              data-index={index}
              aria-label={`${copy.home.openPhoto}: ${photo.alt}`}
            >
              <img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" />
            </button>
          ))}
        </div>
      </div>

      <dialog class="lightbox" data-gallery-dialog>
        <button class="lightbox-close" type="button" data-gallery-close aria-label={copy.home.close}>
          {copy.home.close}
        </button>
        <button class="lightbox-nav prev" type="button" data-gallery-prev aria-label={copy.home.prevPhoto}>
          ‹
        </button>
        <figure>
          <img data-gallery-frame alt="" />
          <figcaption>
            <span data-gallery-caption></span>
            <span data-gallery-count></span>
          </figcaption>
        </figure>
        <button class="lightbox-nav next" type="button" data-gallery-next aria-label={copy.home.nextPhoto}>
          ›
        </button>
      </dialog>
    </section>

    <section class="section wrap visit">
      <div>
        <p class="kicker">{copy.home.visitKicker}</p>
        <h2>{site.address.display}</h2>
        <p class="muted">{copy.hours}</p>
        <div class="hero-actions">
          <a class="btn" href={`tel:${site.telephone}`}>{copy.home.call(site.telephoneDisplay)}</a>
          <a class="btn btn-ghost" href={localizedPath('/contatti', lang)}>{copy.home.directions}</a>
        </div>
      </div>
      <div class="map-card">
        <iframe
          title={copy.home.mapTitle(site.name)}
          src={mapsEmbed(lang)}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
        <a href={site.maps.google} target="_blank" rel="noopener noreferrer">{copy.home.openMaps}</a>
      </div>
    </section>
  </Shell>
</Layout>

<style>
  .hero {
    padding: 4.5rem 0 3.5rem;
  }

  .hero-grid {
    display: grid;
    gap: 2.5rem;
    align-items: end;
  }

  h1 {
    font-size: clamp(3rem, 10.5vw, 8.2rem);
    margin: 1rem 0 1.4rem;
    font-weight: 750;
    line-height: 0.88;
  }

  .line-one {
    display: block;
    font-weight: 550;
  }

  .line-two {
    display: block;
    color: var(--gold);
    font-weight: 800;
  }

  .lead {
    max-width: 38rem;
    color: var(--cream-muted);
    font-size: 1.08rem;
    overflow-wrap: break-word;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .hero-actions .btn {
    flex: 1 1 100%;
  }

  .hero-aside {
    width: 100%;
    max-width: 100%;
  }

  .hero-photo {
    position: relative;
    margin: 0;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: 1.5rem;
  }

  .hero-photo::after,
  .locale-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--cream) 16%, transparent);
    border-radius: inherit;
  }

  .hero-photo img,
  .locale-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-photo img {
    object-position: 50% 58%;
  }

  .hero-photo figcaption {
    position: absolute;
    z-index: 1;
    left: 1rem;
    bottom: 1rem;
    padding: 0.55rem 0.8rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--espresso) 84%, transparent);
    color: var(--gold);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    backdrop-filter: blur(8px);
  }

  .locale {
    display: grid;
    gap: 1.6rem;
    align-items: center;
  }

  .locale-photo {
    position: relative;
    margin: 0;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: 1.5rem;
    min-height: 16rem;
  }

  .locale-photo img {
    object-position: 42% 58%;
  }

  .locale-copy .score {
    margin-bottom: 0.4rem;
  }

  .marquee {
    overflow: hidden;
    max-width: 100%;
    border-block: 1px solid var(--line);
    padding: 0.85rem 0;
    color: var(--gold);
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .track {
    display: flex;
    width: max-content;
    gap: 2rem;
    animation: drift 38s linear infinite;
  }

  .section {
    padding: 5rem 0;
  }

  .aperitivo-band h2,
  .locale h2,
  .gallery h2,
  .visit h2 {
    font-size: clamp(2.4rem, 7vw, 4.6rem);
    max-width: 14ch;
  }

  .gallery {
    padding-top: 0;
  }

  .mosaic {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-flow: dense;
    grid-auto-rows: 9.5rem;
    gap: 0.7rem;
    margin-top: 2rem;
  }

  .shot {
    position: relative;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    border-radius: 1.15rem;
    background: var(--bark);
    cursor: zoom-in;
    min-width: 0;
    min-height: 0;
  }

  .shot::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--cream) 16%, transparent);
  }

  .shot img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s var(--ease);
  }

  .shot:hover img,
  .shot:focus-visible img {
    transform: scale(1.04);
  }

  .shot.wide,
  .shot.banner,
  .shot.tall {
    grid-row: span 2;
  }

  .shot.wide,
  .shot.banner {
    grid-column: span 2;
  }

  .lightbox {
    width: min(72rem, calc(100vw - 1.5rem));
    max-width: calc(100vw - 1.5rem);
    height: min(92dvh, 52rem);
    margin: auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--cream);
    overflow: visible;
  }

  .lightbox::backdrop {
    background: color-mix(in srgb, var(--espresso) 88%, black);
    backdrop-filter: blur(10px);
  }

  .lightbox figure {
    margin: 0;
    height: 100%;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 0.8rem;
  }

  .lightbox img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 1rem;
  }

  .lightbox figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.85rem;
    color: var(--cream-muted);
  }

  .lightbox-close,
  .lightbox-nav {
    position: absolute;
    z-index: 2;
    border: 0;
    background: color-mix(in srgb, var(--espresso) 72%, transparent);
    color: var(--cream);
    cursor: pointer;
    backdrop-filter: blur(8px);
  }

  .lightbox-close {
    top: 0.4rem;
    right: 0.4rem;
    min-height: 2.4rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .lightbox-nav {
    top: 42%;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 999px;
    font-size: 1.8rem;
    line-height: 1;
  }

  .lightbox-nav.prev {
    left: 0.35rem;
  }

  .lightbox-nav.next {
    right: 0.35rem;
  }

  .lightbox-close:hover,
  .lightbox-nav:hover {
    color: var(--gold);
  }

  .aperitivo-band {
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--gold) 8%, transparent), transparent 40%),
      var(--cocoa);
    border-block: 1px solid var(--line);
  }

  .tickets {
    display: grid;
    gap: 1.2rem;
    margin-top: 2.2rem;
  }

  .ticket {
    border: 1px solid var(--line);
    padding: 1.7rem 1.5rem 1.5rem;
    background: color-mix(in srgb, var(--espresso) 55%, transparent);
  }

  .ticket.featured {
    border-color: var(--gold);
    background: color-mix(in srgb, var(--gold) 10%, var(--espresso));
  }

  .when {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    line-height: 1.55;
    max-width: 36ch;
  }

  .ticket h3 {
    font-size: 2.4rem;
    margin: 0.45rem 0 0.35rem;
  }

  .time {
    color: var(--cream-muted);
  }

  .price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.3rem;
  }

  .price span {
    font-family: var(--font-display);
    font-size: 3rem;
    color: var(--gold);
    line-height: 0.8;
  }

  .price small {
    color: var(--cream-muted);
    font-size: 0.88rem;
    max-width: 22rem;
    line-height: 1.4;
  }

  .score {
    font-family: var(--font-display);
    font-size: clamp(4.2rem, 10vw, 7rem);
    color: var(--gold);
    line-height: 0.75;
  }

  .visit {
    display: grid;
    gap: 2rem;
    padding-bottom: 6rem;
  }

  .map-card {
    min-height: 12rem;
    border: 1px solid var(--line);
    overflow: hidden;
    background: var(--bark);
  }

  .map-card iframe {
    display: block;
    width: 100%;
    min-height: 20rem;
    border: 0;
  }

  .map-card a {
    display: block;
    padding: 1rem 1.2rem;
    color: var(--gold);
    text-decoration: none;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-size: 0.75rem;
  }

  @keyframes drift {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (min-width: 860px) {
    .mosaic {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: 11.5rem;
      gap: 0.9rem;
    }

    .shot.banner {
      grid-column: span 4;
    }

    .hero-aside {
      justify-self: end;
      max-width: 28rem;
    }

    .hero-actions .btn {
      flex: 0 0 auto;
    }

    .hero-grid,
    .tickets,
    .locale,
    .visit {
      grid-template-columns: 1fr 1fr;
    }

    .locale {
      gap: 3rem;
    }
  }
</style>

<script>
  type Shot = { src: string; width: number; height: number; alt: string };

  const mosaic = document.querySelector<HTMLElement>('.mosaic');
  const dialog = document.querySelector<HTMLDialogElement>('[data-gallery-dialog]');
  const frame = document.querySelector<HTMLImageElement>('[data-gallery-frame]');
  const caption = document.querySelector('[data-gallery-caption]');
  const count = document.querySelector('[data-gallery-count]');
  let index = 0;

  function shots() {
    return mosaic ? [...mosaic.querySelectorAll<HTMLButtonElement>('[data-gallery-shot]')] : [];
  }

  function show(next: number) {
    const current = shots();
    if (!dialog || !frame || current.length === 0) return;
    index = (next + current.length) % current.length;
    const img = current[index]?.querySelector('img');
    if (!img) return;
    frame.src = img.currentSrc || img.src;
    frame.alt = img.alt;
    if (caption) caption.textContent = img.alt;
    if (count) count.textContent = `${index + 1} / ${current.length}`;
    if (!dialog.open) dialog.showModal();
  }

  function layoutFor(i: number, total: number, width: number, height: number) {
    if (i === total - 1 && width >= height) return 'banner';
    return width >= height ? 'wide' : 'tall';
  }

  function render(photos: Shot[]) {
    if (!mosaic || photos.length === 0) return;
    const current = [...mosaic.querySelectorAll('img')].map((img) => img.getAttribute('src'));
    if (current.length === photos.length && photos.every((photo, i) => current[i] === photo.src)) return;
    mosaic.replaceChildren();
    photos.forEach((photo, i) => {
      const button = document.createElement('button');
      button.className = `shot ${layoutFor(i, photos.length, photo.width, photo.height)}`;
      button.type = 'button';
      button.dataset.galleryShot = '';
      button.dataset.index = String(i);
      const openPhoto = mosaic.dataset.openPhoto ?? 'Apri foto';
      button.setAttribute('aria-label', `${openPhoto}: ${photo.alt}`);
      const img = document.createElement('img');
      img.src = photo.src;
      img.alt = photo.alt;
      img.decoding = 'async';
      img.loading = 'lazy';
      button.append(img);
      mosaic.append(button);
    });
  }

  mosaic?.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const shot = target.closest<HTMLButtonElement>('[data-gallery-shot]');
    if (!shot) return;
    const current = shots();
    const shotIndex = current.indexOf(shot);
    if (shotIndex >= 0) show(shotIndex);
  });

  if (mosaic) {
    const urls = ['/api/public/gallery'];
    const api = mosaic.dataset.api;
    if (api) urls.push(`${api}/api/public/gallery`);
    void loadGallery(urls);
  }

  async function loadGallery(urls: string[]) {
    for (const url of urls) {
      try {
        const res = await fetch(url, { headers: { Accept: 'application/json' } });
        if (!res.ok) continue;
        const data = (await res.json()) as { foto?: Shot[] };
        if (!Array.isArray(data.foto) || data.foto.length === 0) continue;
        render(data.foto);
        return;
      } catch {
        /* prova l'URL successivo */
      }
    }
  }

  dialog?.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement) || !dialog) return;
    if (target === dialog || target.closest('[data-gallery-close]')) dialog.close();
    if (target.closest('[data-gallery-prev]')) show(index - 1);
    if (target.closest('[data-gallery-next]')) show(index + 1);
  });

  document.addEventListener('keydown', (event) => {
    if (!dialog?.open) return;
    if (event.key === 'ArrowRight') show(index + 1);
    if (event.key === 'ArrowLeft') show(index - 1);
  });
</script>
