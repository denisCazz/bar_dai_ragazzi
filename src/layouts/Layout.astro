---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { site } from '../data/site';
import { localeFromPath, localizedPath, locales, stripLocale, t } from '../i18n';

type Crumb = { name: string; path: string };

type Props = {
  title: string;
  description: string;
  path?: string;
  jsonLd?: object[];
  breadcrumbs?: Crumb[];
  noindex?: boolean;
};

const {
  title,
  description,
  path = '/',
  jsonLd = [],
  breadcrumbs = [],
  noindex = false,
} = Astro.props;

const lang = localeFromPath(Astro.url.pathname);
const copy = t(lang);
const barePath = stripLocale(path);
const canonical = new URL(localizedPath(barePath, lang), Astro.site ?? site.url).href;
const ogImage = new URL('/og.png', Astro.site ?? site.url).href;
const pageTitle = barePath === '/' ? `${site.name} · ${site.tagline}` : `${title} · ${site.name}`;
const alternates = locales.map((locale) => ({
  locale,
  href: new URL(localizedPath(barePath, locale), Astro.site ?? site.url).href,
}));

const breadcrumbLd =
  breadcrumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((crumb, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: crumb.name,
          item: new URL(localizedPath(stripLocale(crumb.path), lang), Astro.site ?? site.url).href,
        })),
      }
    : null;
---

<!doctype html>
<html lang={copy.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={copy.keywords.join(', ')} />
    <meta name="author" content={site.legalName} />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, nofollow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta name="theme-color" content="#10241e" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={copy.ogLocale} />
    {alternates
      .filter((alt) => alt.locale !== lang)
      .map((alt) => <meta property="og:locale:alternate" content={t(alt.locale).ogLocale} />)}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="geo.region" content="IT-TO" />
    <meta name="geo.placename" content={`${site.address.city}, ${site.address.regionName}`} />
    <meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />
    <meta name="ICBM" content={`${site.geo.lat}, ${site.geo.lng}`} />
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.locale} href={alt.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    {jsonLd.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
    {breadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}
    <script
      is:inline
      defer
      src="https://umami.bitora.it/script.js"
      data-website-id="82d357bd-bcd8-4112-b7bd-530affc332c4"
    ></script>
  </head>
  <body>
    <a class="skip-link" href="#contenuti">{copy.skip}</a>
    <slot />
  </body>
</html>
