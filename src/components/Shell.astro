---
import Header from './Header.astro';
import Footer from './Footer.astro';
import { site } from '../data/site';
---

<Header />
<main id="contenuti">
  <slot />
</main>
<Footer />

<div class="whatsapp-fab">
  <a href={site.whatsapp} rel="noopener noreferrer" aria-label="Scrivici su WhatsApp">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
      <path
        fill="currentColor"
        d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.48.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35ZM12.05 21.78h-.01A9.87 9.87 0 0 1 7.02 20.4l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26C2.17 5.33 6.6.9 12.06.9a9.82 9.82 0 0 1 6.99 2.9 9.83 9.83 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.89 9.88Zm8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.33.16 11.89c0 2.1.55 4.14 1.59 5.94L0 24l6.3-1.65a11.88 11.88 0 0 0 5.74 1.45h.01c6.55 0 11.89-5.34 11.89-11.9 0-3.18-1.24-6.17-3.48-8.41Z"
      ></path>
    </svg>
  </a>
</div>

<style>
  .whatsapp-fab {
    position: fixed;
    right: 1.1rem;
    bottom: 1.1rem;
    z-index: 25;
  }

  .whatsapp-fab a {
    width: 3.4rem;
    height: 3.4rem;
    display: grid;
    place-items: center;
    background: var(--gold);
    color: var(--espresso);
    border-radius: 999px;
    box-shadow: 0 10px 30px color-mix(in srgb, black 40%, transparent);
  }

  .whatsapp-fab a:hover {
    background: var(--gold-bright);
    color: var(--espresso);
  }

  main {
    padding-bottom: 1rem;
  }
</style>
