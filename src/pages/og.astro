---
import { site } from '../data/site';

export const prerender = true;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>OG {site.name}</title>
    <style>
      html,
      body {
        margin: 0;
        width: 1200px;
        height: 630px;
        overflow: hidden;
        background: #1a120e;
      }
      .card {
        width: 1200px;
        height: 630px;
        display: grid;
        place-items: center;
      }
      img {
        height: 460px;
        width: auto;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <img src="/favicon.png" width="171" height="256" alt={site.name} />
    </div>
  </body>
</html>
